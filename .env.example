# Optional Government Django API. Leave blank to use the local demo data.
VITE_API_BASE_URL=
VITE_DEMO_MODE=true

# OpenStreetMap tiles are used by default. You can override these if needed.
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Weather and geocoding use Open-Meteo public APIs; no API key is required.
